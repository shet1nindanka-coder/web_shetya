generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TEACHER
  STUDENT
  DEVELOPER
}

enum HomeworkNumberStatus {
  GREEN
  YELLOW
  RED
}

enum Subject {
  MATH
  INFORMATICS
}

enum LessonStatus {
  PLANNED
  ACTIVE
  FINISHED
}

enum AttendanceStatus {
  UNKNOWN
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum TestKind {
  PLACEMENT
  LESSON
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum LessonKind {
  LESSON
  HOMEWORK
}

enum AssignmentReason {
  NEW
  REVIEW
  GAP
  DIAGNOSTIC
}

model User {
  id                   String                     @id @default(cuid())
  name                 String
  email                String                     @unique
  passwordHash         String
  role                 UserRole
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  sessions             Session[]
  uploadedFiles        StoredFile[]               @relation("UploadedFiles")
  numberStatuses       StudentTopicNumberStatus[]
  notifications        Notification[]
  studentProfile       StudentProfile?
  groupsLed            StudentGroup[]             @relation("GroupTeacher")
  lessonsTaught        Lesson[]                   @relation("LessonTeacher")
  lessonParticipations LessonParticipant[]
  testsCreated         Test[]                     @relation("TestCreator")
  testAttempts         TestAttempt[]
  topicMasteries       TopicMastery[]
  homeworkAssignments  HomeworkAssignment[]       @relation("StudentHomeworkAssignments")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StoredFile {
  id                     String                    @id @default(cuid())
  originalName           String
  storageKey             String                    @unique
  mimeType               String
  size                   Int
  uploadedAt             DateTime                  @default(now())
  uploadedById           String
  uploadedBy             User                      @relation("UploadedFiles", fields: [uploadedById], references: [id], onDelete: Restrict)
  theoryForTopics        Topic[]                   @relation("TheoryFile")
  homeworkForTopics      Topic[]                   @relation("HomeworkFile")
  answerForNumberEntries TopicHomeworkNumber[]     @relation("NumberAnswerFile")
  submissionPhotoEntries HomeworkSubmissionPhoto[] @relation("SubmissionPhotoFile")
  checkPhotoEntries      HomeworkCheckPhoto[]      @relation("HomeworkCheckPhotoFile")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Topic {
  id                  String                @id @default(cuid())
  title               String
  description         String
  displayOrder        Int                   @default(0)
  theoryFileId        String?
  homeworkFileId      String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  theoryFile          StoredFile?           @relation("TheoryFile", fields: [theoryFileId], references: [id], onDelete: SetNull)
  homeworkFile        StoredFile?           @relation("HomeworkFile", fields: [homeworkFileId], references: [id], onDelete: SetNull)
  homeworkNumbers     TopicHomeworkNumber[]
  subject             Subject               @default(MATH)
  grade               Int?
  prerequisites       Topic[]               @relation("TopicPrereqs")
  requiredFor         Topic[]               @relation("TopicPrereqs")
  masteries           TopicMastery[]
  tests               Test[]                @relation("TestTopic")
  lessons             Lesson[]              @relation("LessonTopic")
  homeworkAssignments HomeworkAssignment[]  @relation("TopicHomeworkAssignments")

  @@index([displayOrder])
  @@index([subject, grade])
}

model TopicHomeworkNumber {
  id                 String                     @id @default(cuid())
  topicId            String
  number             Int
  displayOrder       Int                        @default(0)
  answerFileId       String?
  conditionLatex     String?
  answerLatex        String?
  difficulty         Int?
  estimatedMinutes   Int?
  difficultySource   String?
  usableInDiagnostic Boolean                    @default(false)
  topic              Topic                      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  answerFile         StoredFile?                @relation("NumberAnswerFile", fields: [answerFileId], references: [id], onDelete: SetNull)
  statuses           StudentTopicNumberStatus[]
  assignmentItems    LessonAssignmentItem[]
  testQuestions      TestQuestion[]
  assignmentEntries  HomeworkAssignmentNumber[]
  checkResults       HomeworkCheckResult[]

  @@unique([topicId, number])
  @@index([answerFileId])
  @@index([topicId, displayOrder])
  @@index([usableInDiagnostic])
}

model StudentTopicNumberStatus {
  id               String                @id @default(cuid())
  studentId        String
  homeworkNumberId String
  status           HomeworkNumberStatus?
  note             String?
  deadlineAt       DateTime?
  // Отдельная метка «когда статус реально менялся». updatedAt бампается любым
  // апдейтом строки (в т.ч. зеркалированием дедлайна при выдаче ДЗ), поэтому
  // таймлайн активности и стрик должны опираться на statusChangedAt, а не updatedAt.
  statusChangedAt  DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  student          User                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  homeworkNumber   TopicHomeworkNumber   @relation(fields: [homeworkNumberId], references: [id], onDelete: Cascade)

  @@unique([studentId, homeworkNumberId])
  @@index([studentId, deadlineAt])
  @@index([studentId, status])
  @@index([homeworkNumberId])
}

model StudentProfile {
  id         String        @id @default(cuid())
  userId     String        @unique
  subject    Subject?
  grade      Int?
  levelScore Int?
  placedAt   DateTime?
  speed      Int? // 1..10, «скорость» ученика — подсказка для ИИ, задаётся учителем
  aiNote     String? // свободная заметка учителя об ученике, уходит в промпт подбора
  aiPortrait String? // ИИ-портрет: сильное/слабое/типичные ошибки, генерируется из проверок
  portraitUpdatedAt DateTime?
  groupId    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      StudentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([groupId])
}

model StudentGroup {
  id        String           @id @default(cuid())
  name      String
  subject   Subject          @default(MATH)
  grade     Int?
  teacherId String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  teacher   User             @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  members   StudentProfile[]
  lessons   Lesson[]

  @@index([teacherId])
}

model Lesson {
  id           String              @id @default(cuid())
  title        String
  subject      Subject             @default(MATH)
  teacherId    String
  groupId      String?
  topicId      String?
  status       LessonStatus        @default(PLANNED)
  kind         LessonKind          @default(LESSON) // план занятия или план ДЗ
  deadlineAt   DateTime? // для kind=HOMEWORK: дата следующего занятия = дедлайн ДЗ
  durationMinutes Int              @default(60)
  planParams   Json? // сырые параметры подбора — чтобы пересобрать с теми же настройками
  startsAt     DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  teacher      User                @relation("LessonTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  group        StudentGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  topic        Topic?              @relation("LessonTopic", fields: [topicId], references: [id], onDelete: SetNull)
  participants LessonParticipant[]
  tests        Test[]

  @@index([teacherId])
  @@index([groupId])
  @@index([status])
  @@index([kind])
}

model LessonParticipant {
  id         String                 @id @default(cuid())
  lessonId   String
  studentId  String
  attendance AttendanceStatus       @default(UNKNOWN)
  speed      Int? // переопределение скорости на конкретном занятии
  issuedAssignmentId String? // для планов ДЗ: созданный HomeworkAssignment (без FK — отмена ДЗ не трогает черновик)
  issuedAt   DateTime?
  planSummary String? // пояснение от ИИ, почему набор такой
  planGeneratedAt DateTime?
  planError  String?
  joinedAt   DateTime?
  queueOrder Int?
  helpedAt   DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  lesson     Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student    User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items      LessonAssignmentItem[]

  @@unique([lessonId, studentId])
  @@index([lessonId, queueOrder])
  @@index([studentId])
}

model LessonAssignmentItem {
  id               String              @id @default(cuid())
  participantId    String
  homeworkNumberId String
  order            Int                 @default(0)
  reason           AssignmentReason    @default(NEW)
  forReview        Boolean             @default(false)
  minutes          Int? // оценка времени ОТ МОДЕЛИ, справочная, ни на что не влияет
  comment          String? // короткое пояснение от ИИ, зачем эта задача
  isExtra          Boolean             @default(false) // дополнительная часть: если основная решена раньше времени
  createdAt        DateTime            @default(now())
  participant      LessonParticipant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  homeworkNumber   TopicHomeworkNumber @relation(fields: [homeworkNumberId], references: [id], onDelete: Cascade)

  @@unique([participantId, homeworkNumberId])
  @@index([participantId, order])
  @@index([homeworkNumberId])
}

model Test {
  id              String         @id @default(cuid())
  kind            TestKind
  title           String
  subject         Subject        @default(MATH)
  lessonId        String?
  topicId         String?
  durationMinutes Int            @default(15)
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lesson          Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  topic           Topic?         @relation("TestTopic", fields: [topicId], references: [id], onDelete: SetNull)
  createdBy       User           @relation("TestCreator", fields: [createdById], references: [id], onDelete: Cascade)
  questions       TestQuestion[]
  attempts        TestAttempt[]

  @@index([lessonId])
  @@index([kind])
}

model TestQuestion {
  id               String               @id @default(cuid())
  testId           String
  homeworkNumberId String?
  promptLatex      String?
  correctAnswer    String?
  points           Int                  @default(1)
  order            Int                  @default(0)
  test             Test                 @relation(fields: [testId], references: [id], onDelete: Cascade)
  homeworkNumber   TopicHomeworkNumber? @relation(fields: [homeworkNumberId], references: [id], onDelete: SetNull)
  answers          TestAnswer[]

  @@index([testId, order])
  @@index([homeworkNumberId])
}

model TestAttempt {
  id          String        @id @default(cuid())
  testId      String
  studentId   String
  status      AttemptStatus @default(IN_PROGRESS)
  score       Int?
  maxScore    Int?
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  test        Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     TestAnswer[]

  @@unique([testId, studentId])
  @@index([studentId])
}

model TestAnswer {
  id            String       @id @default(cuid())
  attemptId     String
  questionId    String
  response      String?
  isCorrect     Boolean?
  awardedPoints Int          @default(0)
  attempt       TestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model TopicMastery {
  id         String    @id @default(cuid())
  studentId  String
  topicId    String
  mastered   Boolean   @default(false)
  masteredAt DateTime?
  source     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  student    User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic      Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([studentId, topicId])
  @@index([topicId])
}

model HomeworkAssignment {
  id         String                     @id @default(cuid())
  studentId  String
  topicId    String
  title      String?
  deadlineAt DateTime?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  student    User                       @relation("StudentHomeworkAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  topic      Topic                      @relation("TopicHomeworkAssignments", fields: [topicId], references: [id], onDelete: Cascade)
  numbers    HomeworkAssignmentNumber[]
  photos     HomeworkSubmissionPhoto[]
  checks     HomeworkCheck[]

  @@index([studentId, createdAt])
  @@index([topicId])
}

model HomeworkAssignmentNumber {
  id               String              @id @default(cuid())
  assignmentId     String
  homeworkNumberId String
  assignment       HomeworkAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  homeworkNumber   TopicHomeworkNumber @relation(fields: [homeworkNumberId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, homeworkNumberId])
  @@index([homeworkNumberId])
}

model HomeworkSubmissionPhoto {
  id           String             @id @default(cuid())
  assignmentId String
  fileId       String
  createdAt    DateTime           @default(now())
  assignment   HomeworkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  file         StoredFile         @relation("SubmissionPhotoFile", fields: [fileId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([fileId])
}

enum SolutionCheckStatus {
  PENDING
  CHECKING
  DONE
  FAILED
}

enum SolutionVerdict {
  CORRECT
  INCORRECT
  UNCERTAIN
}

model HomeworkCheck {
  id           String                @id @default(cuid())
  assignmentId String
  status       SolutionCheckStatus   @default(PENDING)
  activeSlot   Int?                  @default(1)
  modelUsed    String?
  error        String?
  createdAt    DateTime              @default(now())
  checkedAt    DateTime?
  assignment   HomeworkAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  results      HomeworkCheckResult[]
  photos       HomeworkCheckPhoto[]

  @@unique([assignmentId, activeSlot])
  @@index([assignmentId, createdAt])
}

model HomeworkCheckPhoto {
  id      String        @id @default(cuid())
  checkId String
  fileId  String
  order   Int
  check   HomeworkCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  file    StoredFile    @relation("HomeworkCheckPhotoFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([checkId, fileId])
  @@unique([checkId, order])
  @@index([fileId])
}

model HomeworkCheckResult {
  id               String              @id @default(cuid())
  checkId          String
  homeworkNumberId String
  verdict          SolutionVerdict
  recognizedAnswer String?
  comment          String?
  confidence       Float?
  copySuspected    Boolean             @default(false)
  copyReason       String?
  check            HomeworkCheck       @relation(fields: [checkId], references: [id], onDelete: Cascade)
  homeworkNumber   TopicHomeworkNumber @relation(fields: [homeworkNumberId], references: [id], onDelete: Cascade)

  @@index([checkId])
  @@index([homeworkNumberId])
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  hits        Int
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

// Настройки сайта из панели разработчика (/teacher/developer).
// Доступ через raw SQL в lib/site-settings.ts (не требует regenerate до миграции).
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
