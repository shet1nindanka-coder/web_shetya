# Docker example. Uses port 5433 to avoid conflicts with a locally installed PostgreSQL on 5432.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/tutor_mvp?schema=public"
# Local PostgreSQL example:
# DATABASE_URL="postgresql://YOUR_PG_USER@127.0.0.1:5432/tutor_mvp?schema=public"
SESSION_TTL_DAYS=30
# Optional for Vercel Blob in production. When set, files are stored in Blob instead of local disk.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Optional Blob access mode. Must match the Vercel Blob store type.
# BLOB_ACCESS="private"
# Optional S3-compatible storage, for example Yandex Object Storage.
# When these values are set and BLOB_READ_WRITE_TOKEN is empty, files are stored in S3/Object Storage.
# S3_ENDPOINT="https://storage.yandexcloud.net"
# S3_REGION="ru-central1"
# S3_BUCKET="tutorflow-files"
# S3_ACCESS_KEY_ID="your-access-key-id"
# S3_SECRET_ACCESS_KEY="your-secret-access-key"
# Optional. For Yandex Object Storage `true` is a safe default.
# S3_FORCE_PATH_STYLE="true"
# Optional Sentry monitoring.
# NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# Optional server-side override. If omitted, the public DSN is reused on the server.
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# SENTRY_ENVIRONMENT="production"
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
# SENTRY_RELEASE="tutorflow@1.0.0"
# SENTRY_TRACES_SAMPLE_RATE="0.1"
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
# Optional build-time source map upload settings.
# SENTRY_AUTH_TOKEN="sntrys_..."
# SENTRY_ORG="your-sentry-org"
# SENTRY_PROJECT="your-sentry-project"
STORAGE_DIR="./storage/uploads"
