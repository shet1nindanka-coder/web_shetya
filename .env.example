# ── База данных ──────────────────────────────────────
# Docker example. Uses port 5433 to avoid conflicts with a locally installed PostgreSQL on 5432.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/tutor_mvp?schema=public"
# Local PostgreSQL example:
# DATABASE_URL="postgresql://YOUR_PG_USER@127.0.0.1:5432/tutor_mvp?schema=public"

# ── Сессии ───────────────────────────────────────────
SESSION_TTL_DAYS=30
# Только для локальной разработки по http. В проде НЕ ставить: снимает флаг Secure
# с сессионной куки, то есть перехваченная кука = захват аккаунта на 30 дней.
# ALLOW_INSECURE_SESSION_COOKIE="false"

# ── Хранилище файлов ─────────────────────────────────
# Бэкенд выбирается по env: BLOB_READ_WRITE_TOKEN → Vercel Blob, иначе S3_* → S3,
# иначе локальный диск в STORAGE_DIR.
# Optional for Vercel Blob in production. When set, files are stored in Blob instead of local disk.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Optional Blob access mode. Must match the Vercel Blob store type. Держите "private":
# в public-режиме файл отдаётся вечным мирочитаемым URL мимо проверки прав.
# BLOB_ACCESS="private"
# Optional S3-compatible storage, for example Yandex Object Storage.
# When these values are set and BLOB_READ_WRITE_TOKEN is empty, files are stored in S3/Object Storage.
# S3_ENDPOINT="https://storage.yandexcloud.net"
# S3_REGION="ru-central1"
# S3_BUCKET="tutorflow-files"
# S3_ACCESS_KEY_ID="your-access-key-id"
# S3_SECRET_ACCESS_KEY="your-secret-access-key"
# Optional. For Yandex Object Storage `true` is a safe default.
# S3_FORCE_PATH_STYLE="true"
STORAGE_DIR="./storage/uploads"

# ── Автопроверка решений (ProxyAPI, OpenAI-совместимый эндпоинт) ──
AI_CHECK_API_KEY=""
AI_CHECK_MODEL="gpt-5.6-sol"
AI_CHECK_BASE_URL="https://api.proxyapi.ru/openai/v1"
# Минимальная уверенность модели (0..1), при которой авто-статус ставится.
# Вердикт с уверенностью ниже порога трактуется как «не распознано» и уходит
# учителю на ручную проверку. По умолчанию 0.6.
AI_CHECK_MIN_CONFIDENCE="0.6"
# Глубина рассуждений модели: minimal | low | medium | high. По умолчанию high.
# AI_CHECK_REASONING_EFFORT="high"
# Глобальный дневной потолок проверок на всю школу. По умолчанию 300.
# Дев-панель (/developer/panel) переопределяет это значение; env — страховка.
# AI_CHECK_DAILY_LIMIT="300"

# ── Хранение фото решений ────────────────────────────
# Автоудаление фото решений (текущих и снапшотов проверок) старше N дней.
# 0 или отрицательное значение — отключить. По умолчанию 365.
HOMEWORK_PHOTO_RETENTION_DAYS="365"

# ── Печатные PDF-раздатки уроков ─────────────────────
# Путь к системному Chromium, если он лежит не по стандартным адресам.
# LESSON_PDF_CHROMIUM_PATH="/usr/bin/chromium"
# "html" — не запускать Chromium вовсе и отдавать HTML-версию для печати.
# LESSON_PDF_RENDERER=""

# ── Журнал действий (панель разработчика) ────────────
# Срок хранения записей журнала в днях. 0 или отрицательное — не чистить.
# По умолчанию 90.
# AUDIT_LOG_RETENTION_DAYS="90"
# Цены провайдера за миллион токенов — по ним считается стоимость вызова
# в момент записи. Дефолты соответствуют gpt-5.6-sol в ProxyAPI.
# AI_PRICE_INPUT_RUB_PER_MTOK="800"
# AI_PRICE_OUTPUT_RUB_PER_MTOK="4700"

# ── Публичный адрес сайта ────────────────────────────
# Уходит в заголовок HTTP-Referer запросов к модели. По умолчанию shbz-edu.ru.
# PUBLIC_SITE_URL="https://shbz-edu.ru"

# ── Логи ─────────────────────────────────────────────
# pino-уровень: trace | debug | info | warn | error | fatal.
# По умолчанию info в production и debug в остальных окружениях.
# LOG_LEVEL="info"

# ── Таймзона приложения ──────────────────────────────
# Обязательно: без неё сервер считает «сегодня» в UTC, и стрики с метками
# просрочки разъезжаются после полуночи по Москве.
TZ="Europe/Moscow"
